<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.iwish.client.controller.WishListController">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <Label styleClass="section-title" text="My Wish List"/>

    <ListView fx:id="itemsListView" VBox.vgrow="ALWAYS"/>

    <Label text="Add / update an item:"/>
    <HBox spacing="8">
        <TextField fx:id="nameField" promptText="Item name" HBox.hgrow="ALWAYS"/>
        <TextField fx:id="priceField" promptText="Price" prefWidth="100"/>
    </HBox>
    <HBox spacing="8">
        <Button text="Add Item" onAction="#handleAdd"/>
        <Button text="Update Selected" onAction="#handleUpdate"/>
        <Button text="Delete Selected" onAction="#handleDelete"/>
    </HBox>

    <Label fx:id="statusLabel" styleClass="error-label" visible="false" managed="false"/>
</VBox>
